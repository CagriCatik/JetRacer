<?xml version="1.0"?>
<package format="3">
  <name>jetracer_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic simulation for the JetRacer autonomous driving stack.
    Provides a simulated environment with Ackermann drive, camera, LiDAR,
    and IMU that exposes the same topic interface as the real Jetson hardware,
    allowing the autonomous pipeline to connect without modification.
  </description>
  <maintainer email="maintainers@example.com">JetRacer ROS 2 Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- jetracer_description provides the base URDF -->
  <depend>jetracer_description</depend>

  <!-- Gazebo Harmonic (gz-sim 8) ROS 2 integration -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <!-- ROS 2 runtime -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
