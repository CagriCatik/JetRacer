<?xml version="1.0" ?>
<!--
  jetracer_track.sdf
  ====================
  Gazebo Harmonic world for JetRacer lane-following development.

  Design goals:
  - Flat ground plane with a painted oval lane for visual lane detection.
  - Minimal geometry — keeps physics and rendering fast on dev laptops.
  - Standard lighting so camera images have consistent exposure.
  - No walls or obstacles (obstacle testing uses a separate world or markers).

  Lane layout:
  - Straight 3 m sections at top and bottom.
  - Semicircular ends with radius 0.75 m.
  - Lane width: 0.40 m (wider than real 0.30 m to be forgiving in sim).
  - White lines: 0.05 m wide, painted as flat box visuals on the ground plane.
  - Total track footprint: ~5.5 m × 3.5 m — fits in most rooms.

  Coordinate system:
  - X forward (robot starts heading +X)
  - Y left
  - Z up
  - Robot spawn pose: x=0, y=0, yaw=0 (heading along +X straight)
-->
<sdf version="1.9">
  <world name="jetracer_track">

    <!-- ── Physics ──────────────────────────────────────────────────────── -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Required Gazebo Harmonic system plugins ───────────────────────── -->
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"        name="gz::sim::systems::Contact"/>

    <!-- ── Lighting ─────────────────────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane (dark grey tarmac) ──────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      ── Lane markings ──────────────────────────────────────────────────────
      The track is an oval:
        - Two straights along X at Y = ±0.20 (lane centres)
        - The white lines are at Y = ±0.20 ± 0.20/2 = Y = 0.0 and Y = ±0.40
        - Each line strip is a thin box raised 0.001 m above ground

      Straight sections: X from -1.5 to +1.5  (3 m each)
      End caps: represented as approximate short line segments at ±1.5

      For simplicity, this is a rectangular loop (not true oval).
      The lane following algorithm works on any closed loop.

      Track dimensions:
        Outer boundary: 5 m × 1.0 m rectangle, centred at origin
        Inner boundary: 4 m × 0.0 m (solid centre stripe)
        Lane: two 0.40 m wide channels, white edge lines
    -->

    <!-- Left outer line: Y = +0.60, along X -->
    <model name="lane_left_outer_top">
      <static>true</static>
      <pose>0 0.60 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Left inner line: Y = +0.20, along X -->
    <model name="lane_left_inner_top">
      <static>true</static>
      <pose>0 0.20 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Right inner line: Y = -0.20, along X -->
    <model name="lane_right_inner_top">
      <static>true</static>
      <pose>0 -0.20 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Right outer line: Y = -0.60, along X -->
    <model name="lane_right_outer_top">
      <static>true</static>
      <pose>0 -0.60 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- End caps: short cross-lines at X = ±2.0 -->
    <model name="lane_end_cap_left">
      <static>true</static>
      <pose>2.0 0 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.3 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lane_end_cap_right">
      <static>true</static>
      <pose>-2.0 0 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.3 0.05 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
