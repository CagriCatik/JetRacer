<?xml version="1.0"?>
<package format="3">
  <name>jetracer_bringup</name>
  <version>0.2.0</version>
  <description>Launch, environment, and deployment glue for the JetRacer ROS 2 stack.</description>
  <maintainer email="maintainers@example.com">JetRacer ROS 2 Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>jetracer_description</exec_depend>
  <exec_depend>jetracer_hardware</exec_depend>
  <exec_depend>jetracer_localization</exec_depend>
  <exec_depend>jetracer_navigation</exec_depend>
  <exec_depend>jetracer_lane_following</exec_depend>
  <exec_depend>jetracer_behavior</exec_depend>
  <exec_depend>jetracer_perception</exec_depend>
  <exec_depend>jetracer_voice</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
